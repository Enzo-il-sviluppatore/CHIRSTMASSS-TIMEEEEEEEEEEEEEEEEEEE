rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "vincenzobal12@gmail.com" && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == "google.com";
    }
    function validNewHold() {
      return signedIn()
        && request.resource.data.status == "held"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.holdKind in ["purchase", "maybe"]
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, "h");
    }
    function validNewPurchase(giftId) {
      return signedIn()
        && request.resource.data.status == "bought"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.holdKind == "purchase"
        && request.resource.data.expiresAt == null
        && getAfter(/databases/$(database)/documents/giftPurchases/$(giftId)).data.ownerUid == request.auth.uid;
    }
    match /gifts/{giftId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /giftHolds/{giftId} {
      allow read: if true;
      allow create: if isAdmin() || validNewHold() || validNewPurchase(giftId);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "held"
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == "bought"
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "expiresAt", "updatedAt"])
        )
        || (
          resource.data.status == "held"
          && resource.data.expiresAt <= request.time
          && validNewHold()
        )
        || (
          resource.data.status == "held"
          && resource.data.expiresAt <= request.time
          && validNewPurchase()
        );
      allow delete: if isAdmin();
    }
    match /giftPurchases/{giftId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() <= 50
        && getAfter(/databases/$(database)/documents/giftHolds/$(giftId)).data.status == "bought"
        && getAfter(/databases/$(database)/documents/giftHolds/$(giftId)).data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}